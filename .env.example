# Covenant — Environment Variables
# Copy to .env and fill in values.

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Razorpay (test-mode) ---
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# --- Mandate signing secret ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MANDATE_SECRET_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://covenant:covenant@localhost:5432/covenant

# --- Policy ---
SPEND_CAP=10000.00

# --- Mandate TTLs (seconds) ---
MANDATE_INTENT_TTL_SECONDS=900
MANDATE_CART_TTL_SECONDS=600
MANDATE_PAYMENT_TTL_SECONDS=300
HUMAN_APPROVAL_TIMEOUT_SECONDS=300
